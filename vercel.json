{
  "crons": [
    {
      "path": "/api/cron-report?frequency=DAILY",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron-report?frequency=WEEKLY",
      "schedule": "0 11 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
